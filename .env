# VARIABLE D'ENV DeV de l'application
# --- Application
SPRING_APPLICATION_NAME=metriquegrafana
SERVER_PORT=8382

# --- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metrique
DB_USER=postgres
DB_PASSWORD=postgres

# --- JPA / Hibernate
# DEV : update | PROD : validate (avec Flyway/Liquibase)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

#-- LOGS ---
LOG_FILE=logs/${SPRING_APPLICATION_NAME}.log
ALLOY_LOKI_URL=http://loki:3100/loki/api/v1/push
ALLOY_LOG_PATH=/app/logs/application.log